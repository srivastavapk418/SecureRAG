API_PREFIX=/api/v1
APP_NAME=Enterprise Knowledge Assistant AI Service
VECTOR_DB_PATH=./data/chroma
CLIENT_URL=http://localhost:5173
SHARED_UPLOAD_DIR=

# AI Provider Selection: "ollama" (default local), "groq" (100% free cloud), or "azure_openai"
LLM_PROVIDER=ollama

# Option 1: Local Ollama (100% offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=180

# Option 2: Groq Cloud API (100% Free Forever with Zero Data Retention)
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# Option 3: Azure OpenAI (Enterprise Zero Data Retention)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-08-01-preview

CHUNK_SIZE=1100
CHUNK_OVERLAP=200
RETRIEVAL_K=5
